# Copy this file to .env.probe and paste your real key in.
#
#   cp .env.probe.example .env.probe
#
# The key belongs to development only: probes spend it so that test runs never land on
# the same line of the usage page as the floor's real builds. Create it at
# console.anthropic.com -> API keys, and name it oa-dev so it is obvious later.
#
# .env.probe is gitignored. This example file is not, and must never hold a real key.
ANTHROPIC_API_KEY_DEV=paste-your-oa-dev-key-here
