dc-dashboard-pages

# Build output and dependencies for the v2 call script. These are generated: the
# deployable bundle is committed under call-script/public/v2 instead.
call-script-v2/node_modules/
call-script-v2/dist/

# The development API key probes spend, so test runs never land on the same line of
# the usage page as the floor's real builds. Never commit it.
call-script-v2/.env.probe

# This repo is the home directory and it pushes to a public GitHub remote, so anything
# left untracked here is one `git add -A` away from being published. .claude holds an
# auth credential, conversation transcripts that quote whatever was typed into them
# including a secret pasted by mistake, and cached tool results containing Gmail and
# Calendar data. Deny the directory and re-admit only what is safe, rather than naming
# the sensitive parts: the next release adds files this list would not know about.
.claude/**
.claude.json
.claude.json.tmp.*
.config/
.gitconfig

# Memory notes are prose worth versioning, not logs. Git will not look inside an ignored
# directory, so each parent has to be re-admitted before the leaf can be.
!.claude/projects/
!.claude/projects/*/
!.claude/projects/*/memory/
!.claude/projects/*/memory/**
